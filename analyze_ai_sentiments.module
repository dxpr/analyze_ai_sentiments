<?php

/**
 * @file
 * Primary module hooks for Analyze AI Sentiments module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\analyze_ai_sentiments\Hook\AnalyzeAiSentimentsHooks;
use Drupal\Core\Entity\EntityInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_color_scale_popover_alter().
 */
#[LegacyHook]
function analyze_ai_sentiments_views_color_scale_popover_alter(array &$content, array $context): void {
  \Drupal::service(AnalyzeAiSentimentsHooks::class)->viewsColorScalePopoverAlter($content, $context);
}

/**
 * Implements hook_entity_update().
 */
#[LegacyHook]
function analyze_ai_sentiments_entity_update(EntityInterface $entity) {
  \Drupal::service(AnalyzeAiSentimentsHooks::class)->entityUpdate($entity);
}

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function analyze_ai_sentiments_entity_delete(EntityInterface $entity) {
  \Drupal::service(AnalyzeAiSentimentsHooks::class)->entityDelete($entity);
}

/**
 * Helper function to check if an entity should be analyzed for sentiments.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE if the entity should be analyzed, FALSE otherwise.
 */
function _analyze_ai_sentiments_is_supported_entity(EntityInterface $entity): bool {
  // Check if this entity type/bundle has sentiments analysis enabled.
  $config = \Drupal::config('analyze.settings');
  $status = $config->get('status') ?? [];

  $entity_type_id = $entity->getEntityTypeId();
  $bundle = $entity->bundle();

  return isset($status[$entity_type_id][$bundle]['ai_sentiments_analyzer']);
}

/**
 * Implements hook_views_pre_view().
 */
#[LegacyHook]
function analyze_ai_sentiments_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  \Drupal::service(AnalyzeAiSentimentsHooks::class)->viewsPreView($view, $display_id, $args);
}
